# Engine environment and downloaded models (setup.bat recreates them)
engine/.venv/
engine/models/
__pycache__/
*.pyc

# Build output
dist/
*.ccx

# Local test output and tool config
test-exports/
node_modules/
.claude/

# Native addon build output (FFmpeg source and build, objects, CLI)
native/build/

# Fetched by scripts/fetch-deps.js (checksum-pinned); the Windows addon itself is committed
.deps-cache/
plugin/win/x64/libmediapipe.dll
plugin/mac/arm64/libmediapipe.dylib

# The macOS addon is built by CI (or native/build-addon-mac.sh), not committed
plugin/mac/arm64/saycheese.uxpaddon
plugin/models/

# Addon copies moved aside while Premiere had them loaded
plugin/win/x64/*.old
*.new
.DS_Store
