{
  "manifestVersion": 6,
  "id": "com.saycheese.smilefinder",
  "name": "SayCheese",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://api.github.com"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    },
    "enableAddon": true
  },
  "addon": {
    "name": "saycheese.uxpaddon"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "saycheese.panel",
      "label": {
        "default": "SayCheese"
      },
      "minimumSize": {
        "width": 620,
        "height": 700
      },
      "maximumSize": {
        "width": 3000,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 720,
        "height": 720
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
